# Copia in .env e cambia i valori. .env non va su git.
# accesso di emergenza dell'amministratore (gli utenti entrano con le credenziali Navidrome)
ARMONY_TOKEN=cambiami-con-una-password-lunga
ARMONY_NAME=Casa
# repository GitHub da cui arrivano gli aggiornamenti (proprietario/nome)
ARMONY_REPO=Giggi-98/Armony
# facoltativo: l'indirizzo con cui gli altri raggiungono Armony (es. https://armony.nome.ts.net), per link, inviti e QR.
# Si può mettere anche dopo, da Impostazioni → Server musicali (lo vede solo l'amministratore)
ARMONY_PUBLIC_URL=
# facoltative: amministratore di Navidrome, per far creare un account agli amici dall'app.
# Se le lasci vuote le inserisce l'admin in Impostazioni → Utenti → Registrazione (restano sul server)
NAVIDROME_ADMIN_USER=
NAVIDROME_ADMIN_PASS=
# facoltativo: avvisi fuori dall'app per errori del server e nuove versioni. Un argomento di ntfy
# (https://ntfy.sh/un-nome-difficile-da-indovinare) o un bot Telegram (https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>)
ARMONY_AVVISI=
# facoltativo: un nome tuo per raggiungere Armony da fuori in HTTPS (profilo "https", vedi deploy/Caddyfile), es. un
# DynDNS. Il router inoltra la 443 da internet a ARMONY_HTTPS_PORT di questa macchina
ARMONY_DOMAIN=
ARMONY_HTTPS_PORT=8460
# password del TURN (profilo "turn"); l'utente è "armony"
TURN_PASS=cambiami-anche-questa
# porte: le scrive installa.sh se le predefinite sono occupate. Navidrome e pot rispondono solo su 127.0.0.1;
# ARMONY_CADDY_ADMIN_PORT è l'API locale di Caddy (profilo "https"). Se cambi ARMONY_PORT, cambiala anche nell'inoltro
# del router o in "tailscale serve"
ARMONY_PORT=8080
NAVIDROME_PORT=4533
POT_PORT=4416
ARMONY_CADDY_ADMIN_PORT=2019
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# profili sempre attivi a ogni "docker compose up" (anche negli aggiornamenti), es. COMPOSE_PROFILES=https,turn
COMPOSE_PROFILES=
