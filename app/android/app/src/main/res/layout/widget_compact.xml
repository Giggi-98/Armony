<?xml version="1.0" encoding="utf-8"?>
<!-- widget piccolo (2x2): copertina piccola accanto ai testi, sotto comandi e barra -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_cover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_cover"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="@string/widget_idle"
                android:textColor="@color/widget_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_sub"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/w_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_press"
            android:contentDescription="@string/widget_prev"
            android:src="@drawable/widget_ic_prev" />

        <ImageButton
            android:id="@+id/w_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@string/widget_play"
            android:src="@drawable/widget_ic_play" />

        <ImageButton
            android:id="@+id/w_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_press"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/widget_ic_next" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:indeterminate="false"
        android:max="1000"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progress="350"
        android:progressDrawable="@drawable/widget_progress" />
</LinearLayout>
