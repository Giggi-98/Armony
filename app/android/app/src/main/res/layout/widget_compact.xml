<?xml version="1.0" encoding="utf-8"?>
<!-- widget piccolo (2x2, 3x2): copertina piccola accanto ai testi, sotto comandi e barra
     Sotto il contenuto: il fondo arrotondato col colore della copertina (w_bg, tinto da ArmonyWidget.java) e una
     sfumatura scura in basso che tiene leggibili testi e comandi su ogni colore -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/w_cover"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/widget_cover"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:scrollHorizontally="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:text="@string/widget_idle"
                    android:textColor="@color/widget_ink"
                    android:textSize="15sp"
                    android:textStyle="bold">
    <!-- il titolo lungo scorre piano (marquee): serve il fuoco -->
    <requestFocus />
</TextView>

                <TextView
                    android:id="@+id/w_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_idle_sub"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_press"
                android:contentDescription="@string/widget_prev"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_prev" />

            <ImageButton
                android:id="@+id/w_toggle"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="@string/widget_play"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_play" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_press"
                android:contentDescription="@string/widget_next"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_ic_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="350"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</FrameLayout>
