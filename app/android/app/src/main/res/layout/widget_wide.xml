<?xml version="1.0" encoding="utf-8"?>
<!-- widget largo (4x2): copertina a sinistra alta quanto il widget, a destra testi, comandi e barra.
     I testi qui sono quelli dell'anteprima nel selettore dei widget; li riscrive ArmonyWidget.java -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/w_cover"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_cover"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="@string/widget_idle"
            android:textColor="@color/widget_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_idle_sub"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/w_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_press"
                android:contentDescription="@string/widget_prev"
                android:src="@drawable/widget_ic_prev" />

            <ImageButton
                android:id="@+id/w_toggle"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/widget_play_bg"
                android:contentDescription="@string/widget_play"
                android:src="@drawable/widget_ic_play" />

            <ImageButton
                android:id="@+id/w_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_press"
                android:contentDescription="@string/widget_next"
                android:src="@drawable/widget_ic_next" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:indeterminate="false"
            android:max="1000"
            android:maxHeight="4dp"
            android:minHeight="4dp"
            android:progress="350"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</LinearLayout>
