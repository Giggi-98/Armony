<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#1B1E36</item>
        <item name="colorPrimaryDark">#1B1E36</item>
        <item name="colorAccent">#F2A541</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- dietro la WebView mentre carica: il blu notte dell'app, non un lampo bianco -->
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>

    <!-- avvio: su Android 12+ lo disegna il sistema con questi due valori, prima con @drawable/splash -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
